# Native Node server. Node 22.13+ (24 recommended).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://cloud.webrom.lat
MODE=native
STORAGE_BACKEND=telegram
DATA_DIR=./var
CONFIG_FILE=
# Leave DATABASE_URL empty for SQLite; reuse the existing PostgreSQL URL for legacy mode.
DATABASE_URL=
DATABASE_TRANSPORT=postgres
# Optional HTTPS transport: only required when DATABASE_TRANSPORT=supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_LAYOUT=native
DATABASE_SCHEMA=teldrive
NODE_DATABASE_SCHEMA=teldrive_node
DATABASE_POOL_SIZE=2
OWNER_USER_ID=
# Private owner editor. Use 'none' to disable. Keep outside STATIC_DIR and version control.
SERVER_CONFIG_FILE=./config.admin.toml
# Optional Passenger restart marker: ./tmp/restart.txt. Leave empty on other platforms.
SERVER_RESTART_FILE=
LEGACY_ENCRYPTION_KEY=
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep DATA_KEY backed up: losing it loses access to encrypted sessions and parts.
DATA_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional unique ID for a single running Node process; defaults to hostname + PID.
TELEGRAM_INSTANCE_ID=
DOWNLOAD_BOTS=20
BOT_ATTEMPTS=2
BOT_RETRY_SECONDS=60
BOT_CLIENT_POOL_SIZE=2
BOT_CLIENT_IDLE_SECONDS=30
UPLOAD_RETRY_ATTEMPTS=5
JOB_POLL_SECONDS=10
JOB_LEASE_SECONDS=300
JOB_BATCH_LIMIT=1000
PENDING_RETENTION_DAYS=30
STATIC_CACHE_BYTES=16777216
# Browser/CDN TTL in seconds for public fonts, images and PDF viewer resources.
# Hashed build assets keep their immutable one-year TTL. 0 disables other caching.
STATIC_ASSET_MAX_AGE=3600
PLAYBACK_TTL_MINUTES=60
MEDIA_ENABLED=true
# Leave paths empty to use the pinned packages' binaries; run scripts/install-media.mjs.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional custom trusted CA bundle; defaults to Node.js bundled roots.
MEDIA_CA_FILE=
MEDIA_CONCURRENCY=1
MEDIA_THREADS=1
# Keep compatible H.264 video and convert audio only; 0 forces video encoding.
MEDIA_COPY_VIDEO=1
MEDIA_ANALYZE_SECONDS=1
MEDIA_MAX_WIDTH=1280
MEDIA_TIMEOUT_SECONDS=7200
MEDIA_PROBE_TIMEOUT_SECONDS=60
MEDIA_PROBE_BYTES=8388608
# Comma-separated Telegram numeric user IDs. REQUIRED in production native mode.
ALLOWED_USERS=
DEMO_AUTH=false
PART_SIZE=16777216
MAX_FILE_SIZE=107374182400
MAX_CONCURRENT_TRANSFERS=2
UPLOAD_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_PER_MINUTE=10
JSON_MAX_BYTES=1048576
# Optional browser integrations: exact origins only, no wildcard.
CORS_ORIGINS=
ALLOW_IFRAME=false
# Used ONLY in gateway mode; fixed operator-controlled origin, not supplied by visitors.
UPSTREAM_URL=

# Rclone runtime, independent of hosting provider. Installer selects var/tools by default.
RCLONE_EXECUTABLE=
RCLONE_MOUNT_ENABLED=true
RCLONE_MOUNT_ROOT=
RCLONE_AGENT_ORIGIN=http://127.0.0.1:5573
RCLONE_MAX_JOBS=2
RCLONE_MAX_CACHE_GIB=100
RCLONE_MAX_CACHE_HOURS=720
RCLONE_REQUEST_SECONDS=120
RCLONE_WORKSPACE_BYTES=1073741824

# Mobile client: Google uses a WEB OAuth client on this server. Never put its secret in VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS JSON manifest and publisher policy/support pages. Empty disables advertising.
MOBILE_ADS_CONFIG_URL=
MOBILE_PRIVACY_URL=
MOBILE_SUPPORT_URL=
