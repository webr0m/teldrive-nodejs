# Native Node server. Node 22.13+ (24 recommended).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://cloud.webrom.lat
MODE=native
STORAGE_BACKEND=telegram
DATA_DIR=./var
CONFIG_FILE=
# Leave DATABASE_URL empty for SQLite; reuse the existing PostgreSQL URL for legacy mode.
DATABASE_URL=
DATABASE_TRANSPORT=postgres
# Optional HTTPS transport: only required when DATABASE_TRANSPORT=supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_LAYOUT=native
DATABASE_SCHEMA=teldrive
NODE_DATABASE_SCHEMA=teldrive_node
DATABASE_POOL_SIZE=2
OWNER_USER_ID=
LEGACY_ENCRYPTION_KEY=
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep DATA_KEY backed up: losing it loses access to encrypted sessions and parts.
DATA_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated Telegram numeric user IDs. REQUIRED in production native mode.
ALLOWED_USERS=
DEMO_AUTH=false
PART_SIZE=16777216
MAX_FILE_SIZE=107374182400
MAX_CONCURRENT_TRANSFERS=2
UPLOAD_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_PER_MINUTE=10
JSON_MAX_BYTES=1048576
# Optional browser integrations: exact origins only, no wildcard.
CORS_ORIGINS=
ALLOW_IFRAME=false
# Used ONLY in gateway mode; fixed operator-controlled origin, not supplied by visitors.
UPSTREAM_URL=
