# Build settings only; the Google secret belongs exclusively to the Node server.
VITE_CLIENT_ONLY=true
VITE_MOBILE_SERVER_URL=https://cloud.webrom.lat
VITE_ADMOB_LIVE=false
MOBILE_ADMOB_ANDROID_APP_ID=
MOBILE_ADMOB_IOS_APP_ID=
MOBILE_VERSION_CODE=500
MOBILE_VERSION_NAME=0.5.0
# Signing values are environment variables; keep the keystore and passwords private.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
